<Window x:Class="MazliBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MázliBoost V0.2.2"
        Width="1120"
        Height="780"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Closing="MainWindow_Closing">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#080B10"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#121820"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#19222C"/>
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#202B37"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8C98A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#62E6A7"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#7AF0B8"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#17372A"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F1C96B"/>
        <SolidColorBrush x:Key="WarningDarkBrush" Color="#3B311B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#25303C"/>

        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2731"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PanelHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3A4A5B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#273440"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.025" Duration="0:0:0.10"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.025" Duration="0:0:0.10"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.10"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.10"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BoostButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="#4BD89A"/>
            <Setter Property="Foreground" Value="#06110D"/>
            <Setter Property="BorderBrush" Value="#73EAB2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,13"/>
        </Style>

        <Style x:Key="OptimizationCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="#3A4654"
                                    Background="#0F141B"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <Path x:Name="CheckMark"
                                      Data="M 3,10 L 8,15 L 17,5"
                                      Stroke="#07100B"
                                      StrokeThickness="2.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Top"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#586979"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#151C24"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#EAF7F0"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D8F5E6"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="#1E2833"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style x:Key="TweakCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid x:Name="MainContent" Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AppTitleText"
                                   Text="MÁZLIBOOST"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="34"
                                   FontWeight="Bold"/>
                        <Border Background="{StaticResource WarningDarkBrush}"
                                CornerRadius="6"
                                Padding="6,2"
                                Margin="10,5,0,0">
                            <TextBlock Text="V0.2.2"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="AppSubtitleText"
                               Text="Windows Gaming Performance Utility"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="14"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="LanguageLabelText"
                                   Text="Languages"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="140"
                                  Height="34"
                                  Margin="0,4,0,0"
                                  SelectedIndex="0"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Magyar"/>
                            <ComboBoxItem Content="Deutsch"/>
                            <ComboBoxItem Content="Español"/>
                            <ComboBoxItem Content="Français"/>
                            <ComboBoxItem Content="Italiano"/>
                            <ComboBoxItem Content="Português"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Background="{StaticResource AccentDarkBrush}"
                            CornerRadius="18"
                            Padding="13,7"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource AccentBrush}"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="ReadyText"
                                       Text="READY"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource CardBorder}"
                    Padding="22"
                    Margin="0,24,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetectedGameLabelText"
                                   Text="DETECTED GAME"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="GameNameText"
                                   Text="No game detected"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="GameStatusText"
                                   Text="Start a game and detect it."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="DetectButton"
                            Content="DETECT AGAIN"
                            Style="{StaticResource MainButton}"
                            Width="132"
                            Height="42"
                            VerticalAlignment="Center"
                            Click="DetectButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" x:Name="HomePage">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.16*"/>
                    <ColumnDefinition Width="0.84*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardBorder}"
                        Padding="24"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="GamingOptimizationsLabelText"
                                       Text="GAMING OPTIMIZATIONS"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="ChooseText"
                                       Text="Choose what MázliBoost should apply."
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Margin="0,5,0,3"/>
                            <TextBlock x:Name="IndependentText"
                                       Text="Each optimization can be enabled or disabled independently."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,22,0,12">
                            <CheckBox x:Name="HighPerformanceCheck" Content="High Performance Power Plan" IsChecked="True" Checked="OptimizationChanged" Unchecked="OptimizationChanged" Style="{StaticResource OptimizationCheckBox}"/>
                            <CheckBox x:Name="GameModeCheck" Content="Windows Game Mode" IsChecked="True" Checked="OptimizationChanged" Unchecked="OptimizationChanged" Style="{StaticResource OptimizationCheckBox}"/>
                            <CheckBox x:Name="GameDvrCheck" Content="Disable Game DVR / Background Capture" IsChecked="True" Checked="OptimizationChanged" Unchecked="OptimizationChanged" Style="{StaticResource OptimizationCheckBox}"/>
                            <CheckBox x:Name="GamePriorityCheck" Content="Optimize Game Process Priority" IsChecked="True" Checked="OptimizationChanged" Unchecked="OptimizationChanged" Style="{StaticResource OptimizationCheckBox}"/>
                            <CheckBox x:Name="MemoryCleanupCheck" Content="Background Memory Cleanup" IsChecked="True" Checked="OptimizationChanged" Unchecked="OptimizationChanged" Style="{StaticResource OptimizationCheckBox}"/>
                            <CheckBox x:Name="GamePowerThrottlingCheck" Content="Disable Game Power Throttling" IsChecked="True" Checked="OptimizationChanged" Unchecked="OptimizationChanged" Style="{StaticResource OptimizationCheckBox}"/>
                            <CheckBox x:Name="GameFullscreenOptimizationCheck" Content="Disable Fullscreen Optimizations (Detected Game)" IsChecked="False" Checked="OptimizationChanged" Unchecked="OptimizationChanged" Style="{StaticResource OptimizationCheckBox}"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock x:Name="SelectedCountText"
                                       Text="Selected: 6 / 7"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BoostButton"
                                    Content="APPLY SELECTED OPTIMIZATIONS"
                                    Style="{StaticResource BoostButton}"
                                    Width="270"
                                    Height="48"
                                    HorizontalAlignment="Right"
                                    Click="BoostButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="MoreTweaksButton"
                            Grid.Row="0"
                            Content="MORE OPTIMIZATIONS &amp; TWEAKS"
                            Style="{StaticResource MainButton}"
                            Height="48"
                            Click="MoreTweaksButton_Click"/>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorder}"
                            Padding="20"
                            Margin="0,14,0,10">
                        <StackPanel>
                            <TextBlock x:Name="SystemLabelText" Text="SYSTEM" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="CurrentHardwareText" Text="Current hardware" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" Margin="0,4,0,14"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CpuText" Text="Unknown CPU" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="MemoryLabelText" Text="MEMORY" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RamText" Text="Unknown" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="PowerPlanLabelText" Text="POWER PLAN" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PowerText" Text="Unknown" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,10,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource AccentDarkBrush}"
                            BorderBrush="#224E3B"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="AdvancedLabelText" Text="ADVANCED" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="FutureText" Text="More tweaks available." Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold" Margin="0,4,0,4"/>
                            <TextBlock x:Name="FutureDescriptionText" Text="Open More Optimizations &amp; Tweaks to explore additional options." Foreground="#A5C9B8" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="TweaksPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="TweaksTitleText" Text="MORE OPTIMIZATIONS &amp; TWEAKS" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="TweaksSubtitleText" Text="Additional Windows and gaming optimizations." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BackButton" Content="←  BACK" Style="{StaticResource MainButton}" Width="96" Height="40" HorizontalAlignment="Right" Click="BackButton_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>

                        <TextBlock x:Name="WindowsTweaksHeader" Text="WINDOWS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,4,0,10"/>

                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="VisualEffectsCheck" Content="Visual Effects to best performance (Changes Windows appearance-Revertable by unchecking)" Checked="VisualEffectsCheck_Changed" Unchecked="VisualEffectsCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="VisualEffectsDescription" Text="Reduces Windows visual effects in favor of responsiveness." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="TransparencyCheck" Content="Disable Transparency Effects" Checked="TransparencyCheck_Changed" Unchecked="TransparencyCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="TransparencyDescription" Text="Changes Windows appearance - Revertable by unchecking." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="MenuDelayCheck" Content="Reduce Menu Show Delay" Checked="MenuDelayCheck_Changed" Unchecked="MenuDelayCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="MenuDelayDescription" Text="Makes Windows menus appear faster - Revertable by unchecking." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="MouseHoverCheck" Content="Reduce Mouse Hover Delay" Checked="MouseHoverCheck_Changed" Unchecked="MouseHoverCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="MouseHoverDescription" Text="Makes hover tooltips appear faster - Revertable by unchecking." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="GamingTweaksHeader" Text="GAMING" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,14,0,10"/>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="TweaksGameModeCheck" Content="Windows Game Mode" Checked="TweaksGameModeCheck_Changed" Unchecked="TweaksGameModeCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="TweaksGameModeDescription" Text="Enables Windows Game Mode." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="TweaksGameDvrCheck" Content="Disable Game DVR / Background Capture" Checked="TweaksGameDvrCheck_Changed" Unchecked="TweaksGameDvrCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="TweaksGameDvrDescription" Text="Reduces background capture activity." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="TweaksHighPerformanceCheck" Content="High Performance Power Plan" Checked="TweaksHighPerformanceCheck_Changed" Unchecked="TweaksHighPerformanceCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="TweaksHighPerformanceDescription" Text="Favors performance over power saving." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ADVANCED GAMING / SYSTEM" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="Bold" Margin="0,14,0,10"/>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="HagsCheck" Content="Hardware-Accelerated GPU Scheduling" Checked="HagsCheck_Changed" Unchecked="HagsCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="HagsDescription" Text="Changes GPU scheduling behavior. Requires a restart." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="GlobalPowerThrottlingCheck" Content="Disable Global Power Throttling" Checked="GlobalPowerThrottlingCheck_Changed" Unchecked="GlobalPowerThrottlingCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="GlobalPowerThrottlingDescription" Text="Disables Windows power throttling system-wide. Requires administrator rights." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="WINDOWS VISUAL / EXTRA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,14,0,10"/>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="StartupDelayCheck" Content="Disable Windows Startup Delay" Checked="StartupDelayCheck_Changed" Unchecked="StartupDelayCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="StartupDelayDescription" Text="Reduces the delay before desktop applications start." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="WindowAnimationsCheck" Content="Disable Window Animations" Checked="WindowAnimationsCheck_Changed" Unchecked="WindowAnimationsCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="WindowAnimationsDescription" Text="Changes Windows appearance - Revertable by unchecking." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="TaskbarAnimationsCheck" Content="Disable Taskbar Animations" Checked="TaskbarAnimationsCheck_Changed" Unchecked="TaskbarAnimationsCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="TaskbarAnimationsDescription" Text="Changes Windows appearance - Revertable by unchecking." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="ExplorerThumbnailsCheck" Content="Disable Explorer Thumbnail Previews" Checked="ExplorerThumbnailsCheck_Changed" Unchecked="ExplorerThumbnailsCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="ExplorerThumbnailsDescription" Text="Changes Windows appearance - Revertable by unchecking." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="AeroPeekCheck" Content="Disable Aero Peek" Checked="AeroPeekCheck_Changed" Unchecked="AeroPeekCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="AeroPeekDescription" Text="Changes Windows appearance - Revertable by unchecking." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="CursorShadowCheck" Content="Disable Cursor Shadow" Checked="CursorShadowCheck_Changed" Unchecked="CursorShadowCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="CursorShadowDescription" Text="Changes Windows appearance - Revertable by unchecking." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TweakCard}">
                            <StackPanel>
                                <CheckBox x:Name="SmoothScrollCheck" Content="Disable Smooth-Scroll Effects" Checked="SmoothScrollCheck_Changed" Unchecked="SmoothScrollCheck_Changed" Style="{StaticResource OptimizationCheckBox}"/>
                                <TextBlock x:Name="SmoothScrollDescription" Text="No reliable system-wide Windows switch is changed by this option." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="26,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource WarningDarkBrush}"
                                BorderBrush="#5C4B28"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,8,0,30">
                            <StackPanel>
                                <TextBlock x:Name="TweaksInfoTitle" Text="ABOUT THESE TWEAKS" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="TweaksInfoText" Text="MázliBoost only applies the selected changes. Registry-based tweaks are used only where appropriate and are designed to be reversible." Foreground="#C9BEA2" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Text="Status: Ready" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <TextBlock x:Name="FooterText" Text="Performance without the snake oil." HorizontalAlignment="Right" Foreground="#596273" FontSize="12"/>
            </Grid>
        </Grid>

        <Grid x:Name="SplashOverlay" Background="Black" Panel.ZIndex="1000">
            <Image x:Name="EngineSplashImage" Stretch="Uniform" Opacity="0" Visibility="Visible"/>
            <Image x:Name="StudioSplashImage" Stretch="Uniform" Opacity="0" Visibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
