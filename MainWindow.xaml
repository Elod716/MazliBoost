<Window x:Class="MazliBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MázliBoost V0.2.1"
        Width="1080"
        Height="760"
        MinWidth="940"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E13"
        Closing="MainWindow_Closing">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- BRUSHES -->
        <!-- ===================================================== -->

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#0A0E13"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#141A22"/>

        <SolidColorBrush x:Key="PanelLightBrush"
                         Color="#1B232E"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F4F7FA"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#8995A6"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#62E6A7"/>

        <SolidColorBrush x:Key="AccentDarkBrush"
                         Color="#17352A"/>

        <SolidColorBrush x:Key="WarningBrush"
                         Color="#F1C96B"/>

        <SolidColorBrush x:Key="WarningDarkBrush"
                         Color="#3A301D"/>


        <!-- ===================================================== -->
        <!-- BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="MainButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#232C38"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="16,10"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- BOOST BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="BoostButton"
               TargetType="Button"
               BasedOn="{StaticResource MainButton}">

            <Setter Property="Background"
                    Value="#38C88D"/>

            <Setter Property="Foreground"
                    Value="#06110D"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Padding"
                    Value="20,15"/>

        </Style>


        <!-- ===================================================== -->
        <!-- CHECKBOX -->
        <!-- ===================================================== -->

        <Style x:Key="OptimizationCheckBox"
               TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,0,4"/>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBOBOX -->
        <!-- ===================================================== -->

        <Style TargetType="ComboBox">

            <Setter Property="Background"
                    Value="#202832"/>

            <Setter Property="Foreground"
                Value="Black"/>

            <Setter Property="BorderBrush"
                    Value="#303A47"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="8,4"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- ROOT -->
    <!-- ========================================================= -->

    <Grid>


        <!-- ===================================================== -->
        <!-- MAIN APPLICATION -->
        <!-- ===================================================== -->

        <Grid x:Name="MainContent"
              Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0">

                <StackPanel>

                    <TextBlock x:Name="AppTitleText"
                               Text="MÁZLIBOOST"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="35"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="AppSubtitleText"
                               Text="Windows Gaming Performance Utility"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="14"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">


                    <!-- LANGUAGE -->

                    <StackPanel Margin="0,0,16,0">

                        <TextBlock x:Name="LanguageLabelText"
                                   Text="Languages"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>

                        <ComboBox x:Name="LanguageComboBox"
                                  Width="125"
                                  Height="32"
                                  Margin="0,4,0,0"
                                  SelectedIndex="0"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">

                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Magyar"/>
                            <ComboBoxItem Content="Deutsch"/>
                            <ComboBoxItem Content="Español"/>
                            <ComboBoxItem Content="Français"/>
                            <ComboBoxItem Content="Italiano"/>
                            <ComboBoxItem Content="Português"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- READY -->

                    <Border Background="{StaticResource AccentDarkBrush}"
                            CornerRadius="18"
                            Padding="13,7"
                            VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource AccentBrush}"
                                     Margin="0,0,8,0"/>

                            <TextBlock x:Name="ReadyText"
                                       Text="READY"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- GAME DETECTION -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="16"
                    Padding="22"
                    Margin="0,25,0,18">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock x:Name="DetectedGameLabelText"
                                   Text="DETECTED GAME"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="GameNameText"
                                   Text="No game detected"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>

                        <TextBlock x:Name="GameStatusText"
                                   Text="Start a game and detect it."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <Button Grid.Column="1"
                            x:Name="DetectButton"
                            Content="DETECT AGAIN"
                            Style="{StaticResource MainButton}"
                            VerticalAlignment="Center"
                            Click="DetectButton_Click"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- NORMAL MAIN PAGE -->
            <!-- ================================================= -->

            <Grid x:Name="HomePage"
                  Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.85*"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- GAMING OPTIMIZATIONS -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,10,0">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <StackPanel>

                            <TextBlock x:Name="GamingOptimizationsLabelText"
                                       Text="GAMING OPTIMIZATIONS"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="ChooseText"
                                       Text="Choose what MázliBoost should apply."
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Margin="0,4,0,3"/>

                            <TextBlock x:Name="IndependentText"
                                       Text="Each optimization can be enabled or disabled independently."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                        </StackPanel>


                        <StackPanel Grid.Row="1"
                                    Margin="0,22,0,10">

                            <CheckBox x:Name="HighPerformanceCheck"
                                      Content="High Performance Power Plan"
                                      IsChecked="True"
                                      Checked="OptimizationChanged"
                                      Unchecked="OptimizationChanged"
                                      Style="{StaticResource OptimizationCheckBox}"/>

                            <CheckBox x:Name="GameModeCheck"
                                      Content="Windows Game Mode"
                                      IsChecked="True"
                                      Checked="OptimizationChanged"
                                      Unchecked="OptimizationChanged"
                                      Style="{StaticResource OptimizationCheckBox}"/>

                            <CheckBox x:Name="GameDvrCheck"
                                      Content="Disable Game DVR / Background Capture"
                                      IsChecked="True"
                                      Checked="OptimizationChanged"
                                      Unchecked="OptimizationChanged"
                                      Style="{StaticResource OptimizationCheckBox}"/>

                            <CheckBox x:Name="GamePriorityCheck"
                                      Content="Optimize Game Process Priority"
                                      IsChecked="True"
                                      Checked="OptimizationChanged"
                                      Unchecked="OptimizationChanged"
                                      Style="{StaticResource OptimizationCheckBox}"/>

                            <CheckBox x:Name="MemoryCleanupCheck"
                                      Content="Background Memory Cleanup"
                                      IsChecked="True"
                                      Checked="OptimizationChanged"
                                      Unchecked="OptimizationChanged"
                                      Style="{StaticResource OptimizationCheckBox}"/>

                            <CheckBox x:Name="GamePowerThrottlingCheck"
                                      Content="Disable Game Power Throttling"
                                      IsChecked="True"
                                      Checked="OptimizationChanged"
                                      Unchecked="OptimizationChanged"
                                      Style="{StaticResource OptimizationCheckBox}"/>

                            <CheckBox x:Name="GameFullscreenOptimizationCheck"
                                      Content="Disable Fullscreen Optimizations (Detected Game)"
                                      IsChecked="False"
                                      Checked="OptimizationChanged"
                                      Unchecked="OptimizationChanged"
                                      Style="{StaticResource OptimizationCheckBox}"/>


                            <Border Background="#10151C"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,8,0,0">

                                <TextBlock x:Name="SelectedCountText"
                                           Text="Selected: 5 / 5"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"/>

                            </Border>

                        </StackPanel>


                        <StackPanel Grid.Row="2">

                            <Button x:Name="BoostButton"
                                    Content="APPLY SELECTED OPTIMIZATIONS"
                                    Style="{StaticResource BoostButton}"
                                    Height="57"
                                    Click="BoostButton_Click"/>

                            <Button x:Name="MoreTweaksButton"
                                    Content="MORE OPTIMIZATIONS &amp; TWEAKS"
                                    Style="{StaticResource MainButton}"
                                    Height="43"
                                    Margin="0,10,0,0"
                                    Click="MoreTweaksButton_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- SYSTEM -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0">

                    <Border Background="{StaticResource PanelBrush}"
                            CornerRadius="16"
                            Padding="22"
                            Margin="0,0,0,15">

                        <StackPanel>

                            <TextBlock x:Name="SystemLabelText"
                                       Text="SYSTEM"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="CurrentHardwareText"
                                       Text="Current hardware"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Margin="0,4,0,20"/>

                            <TextBlock Text="CPU"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>

                            <TextBlock x:Name="CpuText"
                                       Text="Detecting..."
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,15"/>

                            <TextBlock x:Name="MemoryLabelText"
                                       Text="MEMORY"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>

                            <TextBlock x:Name="RamText"
                                       Text="Detecting..."
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,15"/>

                            <TextBlock x:Name="PowerPlanLabelText"
                                       Text="POWER PLAN"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>

                            <TextBlock x:Name="PowerText"
                                       Text="Detecting..."
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <Border Background="{StaticResource PanelBrush}"
                            CornerRadius="16"
                            Padding="22">

                        <StackPanel>

                            <TextBlock x:Name="AdvancedLabelText"
                                       Text="ADVANCED"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="FutureText"
                                       Text="More tweaks available."
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,4,0,5"/>

                            <TextBlock x:Name="FutureDescriptionText"
                                       Text="Open More Optimizations &amp; Tweaks to explore additional options."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- MORE TWEAKS PAGE -->
            <!-- ================================================= -->

            <Grid x:Name="TweaksPage"
                  Grid.Row="0"
                  Grid.RowSpan="4"
                  Visibility="Collapsed"
                  Background="{StaticResource BackgroundBrush}">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- TWEAK HEADER -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock x:Name="TweaksTitleText"
                                   Text="MORE OPTIMIZATIONS &amp; TWEAKS"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="28"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="TweaksSubtitleText"
                                   Text="Additional Windows and gaming optimizations."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <Button x:Name="BackButton"
                            Content="←  BACK"
                            Style="{StaticResource MainButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="BackButton_Click"/>

                </Grid>


                <!-- TWEAK LIST -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>


                        <!-- ================================================= -->
                        <!-- WINDOWS -->
                        <!-- ================================================= -->

                        <TextBlock x:Name="WindowsTweaksHeader"
                                   Text="WINDOWS"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>


                        <!-- VISUAL EFFECTS -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <CheckBox x:Name="VisualEffectsCheck"
                                              Content="Visual Effects to best performance"
                                              Checked="VisualEffectsCheck_Changed"
                                              Unchecked="VisualEffectsCheck_Changed"
                                              Style="{StaticResource OptimizationCheckBox}"/>

                                    <TextBlock x:Name="VisualEffectsDescription"
                                               Text="Changes Windows appearance - Revertable by unchecking."
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               Margin="24,0,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- TRANSPARENCY -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <CheckBox x:Name="TransparencyCheck"
                                          Content="Disable Transparency Effects"
                                          Checked="TransparencyCheck_Changed"
                                          Unchecked="TransparencyCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="TransparencyDescription"
                                           Text="Changes Windows appearance - Revertable by unchecking."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- MENU DELAY -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <CheckBox x:Name="MenuDelayCheck"
                                          Content="Reduce Menu Show Delay"
                                          Checked="MenuDelayCheck_Changed"
                                          Unchecked="MenuDelayCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="MenuDelayDescription"
                                           Text="Makes Windows menus appear faster - Revertable by unchecking."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- MOUSE HOVER -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <CheckBox x:Name="MouseHoverCheck"
                                          Content="Reduce Mouse Hover Delay"
                                          Checked="MouseHoverCheck_Changed"
                                          Unchecked="MouseHoverCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="MouseHoverDescription"
                                           Text="Makes hover tooltips appear faster - Revertable by unchecking."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- ================================================= -->
                        <!-- GAMING -->
                        <!-- ================================================= -->

                        <TextBlock x:Name="GamingTweaksHeader"
                                   Text="GAMING"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>


                        <!-- GAME MODE -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <CheckBox x:Name="TweaksGameModeCheck"
                                          Content="Windows Game Mode"
                                          Checked="TweaksGameModeCheck_Changed"
                                          Unchecked="TweaksGameModeCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="TweaksGameModeDescription"
                                           Text="Enables Windows Game Mode."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- GAME DVR -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <CheckBox x:Name="TweaksGameDvrCheck"
                                          Content="Disable Game DVR / Background Capture"
                                          Checked="TweaksGameDvrCheck_Changed"
                                          Unchecked="TweaksGameDvrCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="TweaksGameDvrDescription"
                                           Text="Reduces background capture activity."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- HIGH PERFORMANCE -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <CheckBox x:Name="TweaksHighPerformanceCheck"
                                          Content="High Performance Power Plan"
                                          Checked="TweaksHighPerformanceCheck_Changed"
                                          Unchecked="TweaksHighPerformanceCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="TweaksHighPerformanceDescription"
                                           Text="Favors performance over power saving."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- STARTUP DELAY -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <CheckBox x:Name="StartupDelayCheck"
                                          Content="Disable Windows Startup Delay"
                                          Checked="StartupDelayCheck_Changed"
                                          Unchecked="StartupDelayCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="StartupDelayDescription"
                                           Text="Reduces the delay before desktop applications start." 
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- WINDOW ANIMATIONS -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <CheckBox x:Name="WindowAnimationsCheck"
                                          Content="Disable Window Animations"
                                          Checked="WindowAnimationsCheck_Changed"
                                          Unchecked="WindowAnimationsCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="WindowAnimationsDescription"
                                           Text="Changes Windows appearance - Revertable by unchecking." 
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- TASKBAR ANIMATIONS -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <CheckBox x:Name="TaskbarAnimationsCheck"
                                          Content="Disable Taskbar Animations"
                                          Checked="TaskbarAnimationsCheck_Changed"
                                          Unchecked="TaskbarAnimationsCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="TaskbarAnimationsDescription"
                                           Text="Changes Windows appearance - Revertable by unchecking." 
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- EXPLORER THUMBNAILS -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <CheckBox x:Name="ExplorerThumbnailsCheck"
                                          Content="Disable Explorer Thumbnail Previews"
                                          Checked="ExplorerThumbnailsCheck_Changed"
                                          Unchecked="ExplorerThumbnailsCheck_Changed"
                                          Style="{StaticResource OptimizationCheckBox}"/>

                                <TextBlock x:Name="ExplorerThumbnailsDescription"
                                           Text="Changes Windows appearance - Revertable by unchecking." 
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="24,0,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- ================================================= -->
                        <!-- INFO -->
                        <!-- ================================================= -->

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,30">

                            <StackPanel>

                                <TextBlock x:Name="TweaksInfoTitle"
                                           Text="ABOUT THESE TWEAKS"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="TweaksInfoText"
                                           Text="MázliBoost only applies the selected changes. Registry-based tweaks are used only where appropriate and are designed to be reversible."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <Grid Grid.Row="3">

                <TextBlock x:Name="StatusText"
                           Text="Status: Ready"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"/>

                <TextBlock x:Name="FooterText"
                           Text="Performance without the snake oil."
                           HorizontalAlignment="Right"
                           Foreground="#596273"
                           FontSize="12"/>

            </Grid>

        </Grid>


        <!-- ===================================================== -->
        <!-- SPLASH OVERLAY -->
        <!-- ===================================================== -->

        <Grid x:Name="SplashOverlay"
              Background="Black"
              Panel.ZIndex="1000">

            <Image x:Name="EngineSplashImage"
                   Stretch="Uniform"
                   Opacity="0"
                   Visibility="Visible"/>

            <Image x:Name="StudioSplashImage"
                   Stretch="Uniform"
                   Opacity="0"
                   Visibility="Hidden"/>

        </Grid>

    </Grid>

</Window>