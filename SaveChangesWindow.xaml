<Window x:Class="MazliBoost.SaveChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        Height="205"
        MinWidth="500"
        MinHeight="205"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0A0E13"
        WindowStyle="SingleBorderWindow">

    <Border Background="#141A22"
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="MessageText"
                       Grid.Row="0"
                       Text="Would you like to save the changes?"
                       Foreground="#F4F7FA"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button x:Name="SaveButton"
                        Width="125"
                        Height="38"
                        Margin="0,0,10,0"
                        Content="Yes and close"
                        Click="SaveButton_Click"
                        Background="#38C88D"
                        Foreground="#06110D"
                        FontWeight="Bold"
                        BorderThickness="0"/>

                <Button x:Name="DiscardButton"
                        Width="140"
                        Height="38"
                        Content="Discard and close"
                        Click="DiscardButton_Click"
                        Background="#232C38"
                        Foreground="#F4F7FA"
                        FontWeight="SemiBold"
                        BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
